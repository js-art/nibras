generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Singleton site content (contact, social, SEO, landing copy).
model SiteSettings {
  id        String   @id @default("default")
  payload   Json
  updatedAt DateTime @updatedAt
}

model City {
  id        String   @id
  country   String
  center    Json
  zoom      Float
  names     Json
  updatedAt DateTime @default(now())
  areas     Area[]

  @@index([updatedAt])
}

model Area {
  id        String    @id
  cityId    String
  color     String
  center    Json
  ring      Json
  image     String
  names     Json
  about     Json
  updatedAt DateTime  @default(now())
  city      City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@index([cityId])
  @@index([updatedAt])
}

model Developer {
  id        String    @id
  names     Json
  about     Json
  delivered Int
  image     String
  updatedAt DateTime  @default(now())
  projects  Project[]

  @@index([updatedAt])
}

model Project {
  id          String    @id
  areaId      String
  developerId String
  kind        String
  handover    String
  startPrice  Float
  sizeMin     Float
  sizeMax     Float
  unitCount   Int
  currency    String    @default("AED")
  point       Json
  ring        Json
  image       String
  names       Json
  about       Json
  whatsapp    String
  phone       String
  units       Json
  payment     Json
  brochure    Json      @default("{}")
  introducedById String?
  updatedAt   DateTime  @default(now())
  area        Area         @relation(fields: [areaId], references: [id], onDelete: Cascade)
  introducedBy CircleProfile? @relation("IntroducedProjects", fields: [introducedById], references: [id], onDelete: SetNull)
  developer   Developer    @relation(fields: [developerId], references: [id], onDelete: Restrict)
  circlePosts CirclePost[]
  desks       CircleDesk[]

  @@index([areaId])
  @@index([developerId])
  @@index([introducedById])
  @@index([updatedAt])
}

model Suggestion {
  id        String   @id
  kind      String
  targetId  String
  order     Int
  updatedAt DateTime @default(now())

  @@index([order])
  @@index([updatedAt])
}

/// Social identity for the agent–investor circle. Ported from Dinka's user graph
/// and extended with a role that sits next to a catalogue project.
model CircleProfile {
  id           String   @id
  handle       String   @unique
  email        String?  @unique
  displayName  String
  role         String
  bio          String   @default("")
  city         String   @default("")
  focus        String   @default("")
  passwordHash String?
  sample       Boolean  @default(false)
  banned       Boolean  @default(false)
  createdAt    DateTime @default(now())

  followingEdges CircleFollow[]    @relation("CircleFollowerSide")
  followerEdges  CircleFollow[]    @relation("CircleFollowedSide")
  posts          CirclePost[]
  comments       CircleComment[]
  reactions      CircleReaction[]
  bookmarks      CircleBookmark[]
  notices        CircleNotice[]    @relation("NoticeRecipient")
  acted          CircleNotice[]    @relation("NoticeActor")
  blocksMade     CircleBlock[]     @relation("BlocksMade")
  blocksGot      CircleBlock[]     @relation("BlocksReceived")
  desks          CircleDesk[]
  introducedProjects Project[] @relation("IntroducedProjects")

  @@index([role])
  @@index([createdAt])
}

model CircleDesk {
  profileId String
  projectId String
  createdAt DateTime      @default(now())
  profile   CircleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([profileId, projectId])
  @@index([projectId])
}

model CircleFollow {
  id          String        @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime      @default(now())
  follower    CircleProfile @relation("CircleFollowerSide", fields: [followerId], references: [id], onDelete: Cascade)
  following   CircleProfile @relation("CircleFollowedSide", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model CircleBlock {
  id        String        @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime      @default(now())
  blocker   CircleProfile @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   CircleProfile @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model CirclePost {
  id         String         @id
  authorId   String
  body       Json
  kind       String         @default("note")
  visibility String         @default("circle")
  projectId  String?
  place      Json?
  sample     Boolean        @default(false)
  createdAt  DateTime       @default(now())
  author     CircleProfile  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project    Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comments   CircleComment[]
  reactions  CircleReaction[]
  bookmarks  CircleBookmark[]
  tags       CirclePostTag[]
  notices    CircleNotice[]

  @@index([authorId, createdAt])
  @@index([projectId])
  @@index([visibility, createdAt])
  @@index([kind])
}

model CircleComment {
  id        String        @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime      @default(now())
  post      CirclePost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    CircleProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model CircleReaction {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  type      String
  createdAt DateTime      @default(now())
  post      CirclePost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      CircleProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model CircleBookmark {
  id        String        @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CirclePost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      CircleProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model CircleTag {
  id       String          @id @default(cuid())
  tag      String          @unique
  useCount Int             @default(0)
  posts    CirclePostTag[]

  @@index([useCount])
}

model CirclePostTag {
  postId String
  tagId  String
  post   CirclePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    CircleTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model CircleNotice {
  id        String        @id @default(cuid())
  userId    String
  actorId   String
  type      String
  postId    String?
  createdAt DateTime      @default(now())
  readAt    DateTime?
  user      CircleProfile @relation("NoticeRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     CircleProfile @relation("NoticeActor", fields: [actorId], references: [id], onDelete: Cascade)
  post      CirclePost?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
